# ──────── GitHub ────────
# PAT/owner usados por scripts que abrem issues ou consultam PRs.
GITHUB_PAT_TOKEN=
GITHUB_OWNER=
GITHUB_ORG=

# ──────── Azure DevOps (adapter opcional) ────────
# Habilite o MCP "azure-devops" no opencode.json antes de usar.
# PAT com permissão de Work Items.
ADO_MCP_AUTH_TOKEN=
AZURE_DEVOPS_ORG=
ADO_ORG=
ADO_PROJECT=
ADO_TEAM=

# ──────── Teams Graph API (adapter opcional) ────────
# Habilite o MCP "teams-graph" no opencode.json antes de usar.
TEAMS_MCP_CLIENT_ID=
TEAMS_MCP_TENANT_ID=
TEAMS_MCP_GRAPH_CLIENT_ID=
TEAMS_MCP_CHAT_ID=
# Caminho completo do Node.js para rodar os MCPs do Teams (opcional)
TEAMS_MCP_NODE_PATH=

# ──────── MySQL (adapter opcional) ────────
# Projeto cujo repositório contém o .env com credenciais MySQL.
MCP_PROJECT=

# ──────── Webhooks (opcional) ────────
PM_WEBHOOK_URL=
