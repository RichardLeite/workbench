{
  "description": "Casos de caracterização para provar paridade entre os scripts Node (legado) e Python (novo).",
  "cases": [
    {
      "id": "validate-branch.valid",
      "argv": [
        "node",
        "scripts/validate-branch-name.js",
        "feat/add-feature"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "validate",
        "branch",
        "feat/add-feature"
      ]
    },
    {
      "id": "validate-branch.invalid",
      "argv": [
        "node",
        "scripts/validate-branch-name.js",
        "Not A Branch"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "validate",
        "branch",
        "Not A Branch"
      ]
    },
    {
      "id": "repo.workbench",
      "argv": [
        "node",
        ".opencode/scripts/repository-resolver.js",
        "--project",
        "workbench"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "repo",
        "resolve",
        "--project",
        "workbench"
      ]
    },
    {
      "id": "repo.all",
      "argv": [
        "node",
        ".opencode/scripts/repository-resolver.js"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "repo",
        "resolve"
      ]
    },
    {
      "id": "validate-spec.valid",
      "argv": [
        "node",
        "scripts/validate-spec-format.js",
        "tests/fixtures/spec-valid.md"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "validate",
        "spec",
        "tests/fixtures/spec-valid.md"
      ]
    },
    {
      "id": "validate-spec.invalid",
      "argv": [
        "node",
        "scripts/validate-spec-format.js",
        "tests/fixtures/spec-invalid.md"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "validate",
        "spec",
        "tests/fixtures/spec-invalid.md"
      ]
    },
    {
      "id": "docs.readme",
      "argv": [
        "node",
        ".opencode/scripts/auto-doc.js",
        "readme"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "docs",
        "readme"
      ]
    },
    {
      "id": "docs.api",
      "argv": [
        "node",
        ".opencode/scripts/auto-doc.js",
        "api"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "docs",
        "api"
      ]
    },
    {
      "id": "knowledge.search",
      "argv": [
        "node",
        ".opencode/scripts/rag-search.js",
        "Workbench",
        "--project",
        "workbench",
        "--limit",
        "2"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "knowledge",
        "search",
        "Workbench",
        "--project",
        "workbench",
        "--limit",
        "2"
      ]
    },
    {
      "id": "metrics.defects",
      "argv": [
        "node",
        ".opencode/scripts/cycle-time.js",
        "--mode=defects"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "metrics",
        "cycle-time",
        "--mode=defects"
      ]
    },
    {
      "id": "spec.migrate.dry-run",
      "argv": [
        "node",
        "scripts/migrate-spec-to-modular.js",
        "tests/fixtures/spec-old.md",
        "--dry-run"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "spec",
        "migrate",
        "tests/fixtures/spec-old.md",
        "--dry-run"
      ],
      "normalize": [
        "dates"
      ]
    },
    {
      "id": "vision.probe",
      "argv": [
        "node",
        "scripts/vision-utils.js",
        "tests/fixtures/sample.png"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "vision",
        "probe",
        "tests/fixtures/sample.png"
      ]
    },
    {
      "id": "vision.probe.invalid",
      "argv": [
        "node",
        "scripts/vision-utils.js",
        "tests/fixtures/too-short.bin"
      ],
      "python_argv": [
        "{python}",
        "-m",
        "workbench",
        "vision",
        "probe",
        "tests/fixtures/too-short.bin"
      ]
    }
  ]
}
