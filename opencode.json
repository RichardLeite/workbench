  "mcp": {
    "azure-devops": {
      "type": "local",
      "command": [
        "node",
        "scripts/start-azure-devops-mcp.js"
      ],
      "enabled": false
    },
    "teams-graph": {
      "type": "local",
      "command": [
        "node",
        "scripts/start-teams-graph-mcp.js"
      ],
      "env": {
        "TEAMS_MCP_CLIENT_ID": "${TEAMS_MCP_CLIENT_ID}"
      },
      "enabled": false
    },
    "mysql": {
      "type": "local",
      "command": [
        "node",
        "scripts/start-mysql-mcp.js"
      ],
      "env": {
        "MCP_PROJECT": "${MCP_PROJECT}"
      },
      "enabled": false
    },
    "mcp-image": {
      "type": "local",
      "command": [
        "node",
        "scripts/mcp-image.js"
      ],
      "enabled": true
    }
  },
  "permission": {
    "question": "allow",
    "bash": {
      "*": "allow",
      "*git push --force *": "ask",
      "*git push -f *": "ask",
      "*git push --force-with-lease *": "ask",
      "*git push * main": "ask",
      "*git push * release": "ask",
      "*git push * develop": "ask",
      "*git push --delete *": "ask",
      "*git push -d *": "ask",
      "*git merge *": "ask",
      "*git rebase *": "ask",
      "*git revert *": "ask",
      "*git reset *": "ask",
      "*git branch -D *": "ask"
    }
  },
  "instructions": [
    ".opencode/rules/constitution.md",
    "AGENTS.md",
    "CONVENTIONS.md",
    ".opencode/rules/rag-retrieval.md",
    ".opencode/rules/tech-debt.md"
  ]
}
