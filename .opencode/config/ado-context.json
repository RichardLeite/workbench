{
  "description": "Configuração do adapter Azure DevOps. Preencha organization, projects, team e projectId com os valores da sua organização. Este arquivo é opcional e só é usado quando o MCP azure-devops está habilitado.",
  "organization": "your-org",
  "patEnvVar": "ADO_MCP_AUTH_TOKEN",
  "apiVersion": "7.0",
  "defaultProject": "Sprint Team",
  "projects": {
    "Sprint Team": {
      "type": "sprint",
      "team": "Sprint Team",
      "projectId": "00000000-0000-0000-0000-000000000000",
      "gitFlow": {
        "command": "/git-sprint",
        "base": "main",
        "branchPattern": "feat/TASK-XXXX",
        "prCount": 1
      }
    },
    "Hotfix Team": {
      "type": "hotfix",
      "team": "Hotfix Team",
      "projectId": "00000000-0000-0000-0000-000000000001",
      "gitFlow": {
        "command": "/git-hotfix",
        "base": "main",
        "branchPattern": "fix/TASK-XXXX",
        "branchPatternRelease": "fix/TASK-XXXX-release",
        "prCount": 2
      }
    }
  }
}
