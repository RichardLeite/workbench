{
  "description": "Convenções de branch — tipos, padrões e regras. Fonte única extraída de pr-config.md Seção 11.",
  "version": 2,
  "pattern": "type/descricao-kebab-case",
  "language": "en",
  "maxDescriptionLength": 50,
  "allowedTypes": ["feat", "fix", "chore", "refactor", "test", "docs", "perf", "style"],
  "patterns": [
    { "atividade": "Feature", "contexto": "qualquer", "pattern": "feat/descricao", "example": "feat/add-feature" },
    { "atividade": "Bugfix", "contexto": "qualquer", "pattern": "fix/descricao", "example": "fix/corrige-login" },
    { "atividade": "Chore", "contexto": "qualquer", "pattern": "chore/descricao", "example": "chore/update-dependencies" },
    { "atividade": "Refactor", "contexto": "qualquer", "pattern": "refactor/descricao", "example": "refactor/extrai-servico" },
    { "atividade": "Docs", "contexto": "qualquer", "pattern": "docs/descricao", "example": "docs/atualiza-readme" }
  ],
  "rules": [
    "Nunca criar branch em main ou release — sempre da base correta",
    "Prefixo do tipo em minúsculo com /: feat/, fix/, chore/",
    "Descrição em kebab-case",
    "Sem caracteres especiais: evitar acentos, @, #",
    "Curta e objetiva: máximo ~50 caracteres",
    "Branches efêmeras: apagadas após merge"
  ]
}
