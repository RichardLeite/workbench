{
  "description": "Regras do fluxo de hotfix (/git-hotfix). Branch patterns, quality gates, cherry-pick, PRs.",
  "version": 1,
  "branchPattern": "fix/TASK-XXXX",
  "branchPatternRelease": "fix/TASK-XXXX-release",
  "baseMain": "main",
  "baseRelease": "release",
  "prTargetMain": "main",
  "prTargetRelease": "release",
  "prCount": 2,
  "commitTypes": ["fix", "feat", "chore", "docs", "refactor", "perf", "test"],
  "cherryPickRequired": true,
  "requireSecurityReview": true,
  "minReviewers": 2,
  "qualityGates": {
    "lint": { "required": false, "blocking": false },
    "sast": { "required": true, "blocking": true },
    "security": { "required": true, "blocking": true },
    "aiReview": { "required": true, "blocking": true }
  },
  "securityBlocking": true,
  "aiReviewBlocking": true,
  "qualityGateCommands": {
    "default": {
      "lint": null,
      "sast": "semgrep --config=auto --error .",
      "security": "trivy fs --scanners vuln,secret --exit-code 1 ."
    },
    ".workbench": {
      "lint": null,
      "sast": "semgrep --config=auto .opencode/",
      "security": "trivy fs --scanners vuln,secret ."
    }
  },
  "vaultRequired": false,
  "notifications": false
}
